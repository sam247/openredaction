  "scripts": {
    "bench": "bun run bench:node && bun run bench:bun",
    "bench:node": "tsx tests/performance.bench.ts && tsx tests/cache-performance.bench.ts",
    "bench:bun": "bun -b tests/performance.bench.ts && bun -b tests/cache-performance.bench.ts",
    "bench:bun:smol": "bun -b tests/performance.bench.ts --smol && bun -b tests/cache-performance.bench.ts --smol",
    "build": "tsdown",
    "clean": "rm -rf dist",
    "dev": "tsdown --watch",
    "lint": "biome check . --diagnostic-level=error",
    "typecheck": "tsc --noEmit --incremental",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch"
  },
