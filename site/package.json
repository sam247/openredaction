{
  "name": "openredaction-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run build:playground-lib && next dev",
    "build": "npm run build:playground-lib && npm run docs:export && next build --turbopack",
    "build:playground-lib": "mkdir -p public/lib && bunx esbuild ../packages/core/src/lite.ts --bundle --format=esm --platform=browser --outfile=public/lib/openredaction-lite.mjs",
    "start": "next start",
    "lint": "biome check . --diagnostic-level=error",
    "typecheck": "tsc --noEmit --incremental",
    "docs:export": "cd docs && npm ci && npm run build && rm -rf ../public/docs && mkdir -p ../public && cp -R out ../public/docs"
  },
  "dependencies": {
    "@openredaction/core": "workspace:*",
    "botid": "^1.5.10",
    "clsx": "^2.1.0",
    "lucide-react": "^0.344.0",
    "next": "16.2.12",
    "nodemailer": "^9.0.3",
    "openredaction": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.4.2",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.1",
    "@types/node": "^20.11.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.28.1",
    "postcss": "^8.4.33",
    "tailwindcss": "^4.3.3"
  }
}
